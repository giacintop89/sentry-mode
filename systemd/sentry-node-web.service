[Unit]
Description=Sentry Node web dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sentry-node
WorkingDirectory=/opt/sentry-node
EnvironmentFile=-/opt/sentry-node/.env
ExecStart=/opt/sentry-node/.venv/bin/sentry-node serve --host 0.0.0.0 --port 8083 --https-port 8443 --tls-cert /opt/sentry-node/.local/tls/server.crt --tls-key /opt/sentry-node/.local/tls/server.key --tls-ca /opt/sentry-node/.local/tls/ca.crt
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
