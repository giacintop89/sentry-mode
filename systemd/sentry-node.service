[Unit]
Description=Sentry Node hardware runtime
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sentry-node
WorkingDirectory=/opt/sentry-node
EnvironmentFile=-/opt/sentry-node/.env
ExecStart=/opt/sentry-node/.venv/bin/sentry-node run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
