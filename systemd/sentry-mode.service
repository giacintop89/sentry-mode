[Unit]
Description=Sentry Mode hardware runtime
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sentry-mode
WorkingDirectory=/opt/sentry-mode
EnvironmentFile=-/opt/sentry-mode/.env
ExecStart=/opt/sentry-mode/.venv/bin/sentry-mode run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
