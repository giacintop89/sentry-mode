[Unit]
Description=Sentry Mode web dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sentry-mode
WorkingDirectory=/opt/sentry-mode
EnvironmentFile=-/opt/sentry-mode/.env
ExecStart=/opt/sentry-mode/.venv/bin/sentry-mode serve --host 127.0.0.1 --port 8083 --https-host 0.0.0.0 --https-port 8443 --tls-cert /opt/sentry-mode/.local/tls/server.crt --tls-key /opt/sentry-mode/.local/tls/server.key --tls-ca /opt/sentry-mode/.local/tls/ca.crt
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
