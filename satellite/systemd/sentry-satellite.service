[Unit]
Description=Sentry Mode satellite agent
Documentation=https://github.com/giacintop89/sentry-mode
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=sentry-satellite
Group=sentry-satellite
SupplementaryGroups=gpio i2c spi audio video bluetooth
ExecStart=/opt/sentry-satellite/venv/bin/sentry-satellite --config /etc/sentry-satellite/node.toml --identity /etc/sentry-satellite/identity.json --state-dir /var/lib/sentry-satellite run
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed

# The agent reads sensors, talks to one broker and sends video to the same hub.
# It has no business anywhere else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadOnlyPaths=/etc/sentry-satellite
RuntimeDirectory=sentry-satellite
# Sources the hub configured live here, never in /etc: the installed file stays as written.
StateDirectory=sentry-satellite
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
